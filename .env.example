# Copy to .env and adjust before `docker compose up` if you want non-default credentials.
MYSQL_ROOT_PASSWORD=rootpass
DB_USER=hms
DB_PASSWORD=hms
JWT_SECRET=dev-only-change-me-hms-shared-signing-secret-key-32-bytes-min
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
# Bootstrap ADMIN account, created on first start (registration can't create ADMINs)
HMS_ADMIN_EMAIL=admin@hms.local
HMS_ADMIN_PASSWORD=ChangeMe!Admin123
